// modules/xnhau.js
// - Reply + chỉ gõ số (không cần prefix) để chọn phim
// - Tìm kiếm linh hoạt: parse nhiều selector, fallback
// - Khi chọn: gửi video + caption + thông tin phim

const https = require("https");
const fs = require("fs");
const path = require("path");

const BASE_URL = "https://xnhau.plus/";
const SEARCH_URL = "https://xnhau.plus/?s=";
const CACHE_DIR = path.join(__dirname, "..", "cache");

if (!global.searchMemory) global.searchMemory = new Map();
if (!fs.existsSync(CACHE_DIR)) fs.mkdirSync(CACHE_DIR, { recursive: true });

function fetchHTML(url, depth = 0) {
  return new Promise((resolve, reject) => {
    if (depth > 3) return reject(new Error("Too many redirects"));
    const req = https.get(url, {
      headers: {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
        "Accept": "text/html,application/xhtml+xml",
        "Accept-Language": "vi,en;q=0.9",
        "Referer": BASE_URL
      },
      timeout: 15000
    }, (res) => {
      if ([301,302,303,307,308].includes(res.statusCode) && res.headers.location) {
        return fetchHTML(res.headers.location, depth + 1).then(resolve).catch(reject);
      }
      let data = "";
      res.setEncoding("utf8");
      res.on("data", c => data += c);
      res.on("end", () => resolve({ html: data, status: res.statusCode }));
    });
    req.on("timeout", () => req.destroy(new Error("Timeout")));
    req.on("error", reject);
  });
}

function downloadFile(url, destPath) {
  return new Promise((resolve, reject) => {
    const file = fs.createWriteStream(destPath);
    https.get(url, {
      headers: { "User-Agent": "Mozilla/5.0", "Referer": BASE_URL, "Accept": "*/*" }
    }, (res) => {
      if (res.statusCode !== 200) {
        file.close();
        try { fs.unlinkSync(destPath); } catch (_) {}
        return reject(new Error(`HTTP ${res.statusCode}`));
      }
      res.pipe(file);
      file.on("finish", () => { file.close(); resolve(); });
    }).on("error", (err) => {
      file.close();
      try { fs.unlinkSync(destPath); } catch (_) {}
      reject(err);
    });
  });
}

function absUrl(link) {
  if (!link) return null;
  if (link.startsWith("http")) return link;
  return BASE_URL + (link.startsWith("/") ? link.slice(1) : link);
}

function decodeEntities(s) {
  return s
    .replace(/&amp;/g,"&").replace(/&quot;/g,'"').replace(/&#039;/g,"'")
    .replace(/&lt;/g,"<").replace(/&gt;/g,">").replace(/&nbsp;/g," ");
}

function parseMovies(html, limit = 8) {
  const results = [], seen = new Set();
  let re = /<a[^>]+href="([^"]+)"[^>]*title="([^"]+)"/gi, m;
  while ((m = re.exec(html)) !== null) {
    let [, link, title] = m;
    if (link.includes("/the-loai/") || link.includes("/tag/") ||
        link.startsWith("javascript:") || link === "#") continue;
    link = absUrl(link);
    title = decodeEntities(title).trim();
    if (!title || !link || seen.has(link)) continue;
    seen.add(link); results.push({ title, link });
  }
  re = /<a[^>]+href="([^"]+)"[^>]*>([^<]{3,120})<\/a>/gi;
  while ((m = re.exec(html)) !== null) {
    let [, link, title] = m;
    if (link.includes("/the-loai/") || link.includes("/tag/") ||
        link.startsWith("javascript:") || link === "#") continue;
    link = absUrl(link);
    title = decodeEntities(title).trim();
    if (!title || title.length < 3 || !link || seen.has(link)) continue;
    if (/^(Trang chủ|Trang|Next|Prev|Tiếp|Trước|\d+)$/i.test(title)) continue;
    seen.add(link); results.push({ title, link });
  }
  return results.slice(0, limit);
}

function extractVideoInfo(html) {
  let videoUrl = null, m;
  m = html.match(/<(?:video|source)[^>]+src=["']([^"']+\.mp4[^"']*)["']/i); if (m) videoUrl = m[1];
  if (!videoUrl) {
    m = html.match(/<meta[^>]+property=["']og:video(?::url|:secure_url)?["'][^>]+content=["']([^"']+)["']/i);
    if (m) videoUrl = m[1];
  }
  if (!videoUrl) {
    m = html.match(/(https?:\/\/[^"'\s<>]+\.mp4[^"'\s<>]*)/i); if (m) videoUrl = m[1];
  }
  let iframe = null;
  const ifr = html.match(/<iframe[^>]+src=["']([^"']+)["']/i); if (ifr) iframe = ifr[1];
  const t = html.match(/<meta[^>]+property=["']og:title["'][^>]+content=["']([^"']+)["']/i)
          || html.match(/<title>([^<]+)<\/title>/i);
  const d = html.match(/<meta[^>]+(?:name|property)=["'](?:description|og:description)["'][^>]+content=["']([^"']+)["']/i);
  return {
    videoUrl: videoUrl ? absUrl(videoUrl) : null,
    iframe: iframe ? absUrl(iframe) : null,
    title: t ? decodeEntities(t[1]).trim() : null,
    desc: d ? decodeEntities(d[1]).trim() : null
  };
}

module.exports = {
  name: "xnhau",
  description: "Tìm kiếm và tải video",
  role: "user",
  execute: async (api, message, args) => {
    const threadId = message.threadId, type = message.type;
    const content = (args || []).join(" ").trim();
        const isNumeric = /^\d+$/.test(content) || /^!\d+$/.test(content);
    const cleanContent = content.replace(/^!/, "");
    const choice = parseInt(cleanContent, 10);
    const quote = message.data && message.data.quote;

    if (quote && quote.globalMsgId && global.searchMemory.has(quote.globalMsgId) && isNumeric) {
      const movies = global.searchMemory.get(quote.globalMsgId);
      if (choice < 1 || choice > movies.length)
        return api.sendMessage(`⚠️ Nhập số từ 1 đến ${movies.length}`, threadId, type);
      const target = movies[choice - 1];
      await api.sendMessage(`⏳ Đang trích xuất: ${target.title}...`, threadId, type);
      try {
        const { html } = await fetchHTML(target.link);
        const info = extractVideoInfo(html);
        if (!info.videoUrl && !info.iframe)
          return api.sendMessage(`❌ Không tìm thấy link tải.\n🔗 ${target.link}`, threadId, type);
        if (info.videoUrl) {
          const savePath = path.join(CACHE_DIR, `video_${Date.now()}.mp4`);
          await api.sendMessage("⏳ Đang tải video...", threadId, type);
          await downloadFile(info.videoUrl, savePath);
          let cap = `🎬 ${info.title || target.title}\n`;
          if (info.desc) cap += `📝 ${info.desc.slice(0,300)}\n`;
          cap += `🔗 ${target.link}`;
          await api.sendMessage({ msg: cap, attachments: [savePath] }, threadId, type);
          fs.unlink(savePath, () => {});
        } else {
          await api.sendMessage(`🎬 ${info.title || target.title}\n🎞️ ${info.iframe}\n🔗 ${target.link}`, threadId, type);
        }
        global.searchMemory.delete(quote.globalMsgId);
      } catch (err) {
        return api.sendMessage(`❌ Lỗi: ${err.message}`, threadId, type);
      }
      return;
    }

    if (!content || content === "help") {
      return api.sendMessage(
        "🌐 **HƯỚNG DẪN**\n👉 `!xnhau <từ khóa>`: Tìm kiếm\n👉 Reply tin nhắn kết quả + gõ số (VD: `1`) để tải.",
        threadId, type);
    }

    await api.sendMessage(`🔍 Đang tìm: **${content}**...`, threadId, type);
    try {
      const { html, status } = await fetchHTML(SEARCH_URL + encodeURIComponent(content));
      if (status !== 200) return api.sendMessage(`❌ HTTP ${status}`, threadId, type);
      const movies = parseMovies(html, 8);
      if (movies.length === 0) return api.sendMessage(`❌ Không có kết quả: ${content}`, threadId, type);
      let msg = `🎬 **KẾT QUẢ: ${content.toUpperCase()}**\n━━━━━━━━━━━━━━━━━━━━\n`;
      movies.forEach((m, i) => { msg += `${i+1}. ${m.title}\n🔗 ${m.link}\n\n`; });
      msg += `👉 **Reply tin nhắn này + gõ số (VD: 1) để tải!**`;
      const sent = await api.sendMessage(msg, threadId, type);
      const msgId = sent?.message?.msgId || sent?.msgId;
      if (msgId) global.searchMemory.set(msgId, movies);
    } catch (err) {
      return api.sendMessage(`❌ Lỗi cào: ${err.message}`, threadId, type);
    }
  }
};
