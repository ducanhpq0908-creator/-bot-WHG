const fs = require("fs");
const path = require("path");

const running = global.DUCANH_TAG_JOBS || (global.DUCANH_TAG_JOBS = new Map());

module.exports = {
    name: "tag",
    description: "DUCANH - Gửi nội dung từ ngonwar.txt",
    role: "admin",

    execute: async (api, message, args, config) => {
        const threadId = message.threadId;
        const type = message.type;
        const sender = String(message.data.uidFrom);
        const admins = (config.admin_uids || []).map(String);

        if (!admins.includes(sender)) {
            return api.sendMessage("❌ Bạn không có quyền.", threadId, type);
        }

        const action = (args[0] || "").toLowerCase();

        if (action === "stop" || action === "off") {
            const job = running.get(String(threadId));
            if (job) {
                job.stop = true;
                return api.sendMessage("⏹ Đã nhận lệnh dừng.", threadId, type);
            }
            return api.sendMessage("ℹ️ Hiện không có tác vụ nào đang chạy.", threadId, type);
        }

        if (action !== "on") {
            return api.sendMessage(
                "📌 Cách dùng:\n!tag on — gửi nội dung từ ngonwar.txt\n!tag stop — dừng",
                threadId, type
            );
        }

        const key = String(threadId);
        if (running.has(key)) {
            return api.sendMessage("⚠️ Tác vụ đang chạy. Dùng !tag stop để dừng trước.", threadId, type);
        }

        const file = path.join(__dirname, "..", "ngonwar.txt");
        if (!fs.existsSync(file)) {
            return api.sendMessage("❌ Không tìm thấy ngonwar.txt.", threadId, type);
        }

        let lines;
        try {
            lines = fs.readFileSync(file, "utf8")
                .split(/\r?\n/)
                .map(line => line.trim())
                .filter(Boolean);
        } catch (err) {
            console.error("Đọc ngonwar.txt thất bại:", err);
            return api.sendMessage("❌ Không đọc được ngonwar.txt.", threadId, type);
        }

        if (!lines.length) {
            return api.sendMessage("⚠️ ngonwar.txt không có nội dung.", threadId, type);
        }

        const job = { stop: false };
        running.set(key, job);


        let sent = 0;
        try {
            for (const line of lines) {
                if (job.stop) break;

                await api.sendMessage(line, threadId, type);
                sent++;

                // Giới hạn tốc độ gửi: tối thiểu 3 giây giữa các tin.
                await new Promise(resolve => setTimeout(resolve, 100));
            }
        } catch (err) {
            console.error("DUCANH tag:", err);
            await api.sendMessage("❌ Có lỗi khi gửi nội dung. Tác vụ đã dừng.", threadId, type);
            return;
        } finally {
            running.delete(key);
        }

        await api.sendMessage(
            job.stop
                ? `⏹ Đã dừng. Đã gửi ${sent}/${lines.length} dòng.`
                : `✅ Đã gửi hết ${sent} dòng trong ngonwar.txt.`,
            threadId, type
        );
    }
};
